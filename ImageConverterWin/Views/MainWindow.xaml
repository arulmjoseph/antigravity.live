<Window x:Class="ImageConverterWin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Converter — Bulk WebP, PDF &amp; Image Optimizer" Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="🖼️ Image Converter" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                    <TextBlock Text="v1.0" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,4,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="❓ Help &amp; Guide" Click="Help_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Margin="0,0,10,0" Padding="8,4"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Body Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="430" MinWidth="350" MaxWidth="600"/>
            </Grid.ColumnDefinitions>

            <!-- Left File Drop / Queue View -->
            <Grid Grid.Column="0" Margin="16">
                <!-- Drop Zone (Visible when queue is empty) -->
                <Border x:Name="DropZoneArea" Background="White" BorderBrush="{StaticResource AccentColor}" BorderThickness="2" CornerRadius="12" Padding="30">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderDashArray" Value="4,4"/>
                        </Style>
                    </Border.Style>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="📥" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Drag &amp; Drop Images or PDFs Here" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Drop single or bulk files, PDFs, or entire folders" FontSize="13" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,20"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="➕ Select Files..." Click="SelectFiles_Click" Background="{StaticResource AccentColor}" Foreground="White" FontWeight="SemiBold" Padding="14,8" Margin="0,0,10,0"/>
                            <Button Content="📁 Select Folder..." Click="SelectFolder_Click" Padding="14,8"/>
                        </StackPanel>

                        <TextBlock Text="Supports WEBP, PDF, JPG, PNG, HEIC, AVIF, TIFF, BMP, GIF" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Queue List View (Visible when items > 0) -->
                <Grid x:Name="QueueArea" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="ItemCountText" Text="0 Items" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="➕ Add More" Click="SelectFiles_Click" Padding="10,4" Margin="0,0,8,0"/>
                            <Button Content="🗑️ Clear All" Click="ClearAll_Click" Padding="10,4"/>
                        </StackPanel>
                    </DockPanel>

                    <ListView x:Name="QueueListView" Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Source="{Binding Thumbnail}" Width="44" Height="44" Stretch="Uniform"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock Text=" • " Foreground="#999999"/>
                                            <TextBlock Text="{Binding DimensionsString}" Foreground="#666666" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding FormattedSize}" Foreground="#888888" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>

                                    <Button Grid.Column="3" Content="❌" Click="RemoveItem_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <!-- Splitter Divider -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderColor}"/>

            <!-- Right Settings Sidebar -->
            <ScrollViewer Grid.Column="2" Background="{StaticResource SidebarBackground}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16">
                    <!-- Format & Quality Section -->
                    <GroupBox Header="Target Format &amp; Compression" Margin="0,0,0,12" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Format:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ComboBox x:Name="FormatComboBox" SelectionChanged="FormatComboBox_SelectionChanged" Margin="0,0,0,10"/>

                            <CheckBox x:Name="OptimizeWebCheckBox" Content="Optimize for Web (Strip EXIF/Metadata)" IsChecked="True" Margin="0,0,0,10"/>

                            <TextBlock Text="Compression Quality:" FontWeight="SemiBold"/>
                            <DockPanel Margin="0,4,0,0">
                                <TextBlock x:Name="QualityText" Text="85%" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                                <Slider x:Name="QualitySlider" Minimum="0.1" Maximum="1.0" Value="0.85" SmallChange="0.05" LargeChange="0.1" ValueChanged="QualitySlider_ValueChanged"/>
                            </DockPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Image Size Section -->
                    <GroupBox Header="Image Size / Width" Margin="0,0,0,12" Padding="10">
                        <StackPanel>
                            <RadioButton x:Name="CustomWidthRadio" Content="Custom Width" IsChecked="True" Checked="SizeRadio_Checked" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="20,0,0,10">
                                <TextBlock Text="Width:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="WidthTextBox" Text="500" Width="80" Padding="4,2"/>
                                <TextBlock Text="px (Height auto-scales)" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0"/>
                            </StackPanel>

                            <RadioButton x:Name="OriginalSizeRadio" Content="Original Size" Checked="SizeRadio_Checked"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Renaming & SEO Section -->
                    <GroupBox Header="File Renaming &amp; Bulk SEO" Margin="0,0,0,12" Padding="10">
                        <StackPanel>
                            <RadioButton x:Name="SeoNamingRadio" Content="Bulk SEO Keywords" IsChecked="True" Checked="NamingRadio_Checked" Margin="0,0,0,6"/>
                            <TextBox x:Name="SeoKeywordsTextBox" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Margin="20,0,0,10"/>

                            <RadioButton x:Name="SequenceNamingRadio" Content="Custom Sequence (e.g. image_001)" Checked="NamingRadio_Checked" Margin="0,0,0,6"/>
                            <RadioButton x:Name="OriginalNamingRadio" Content="Original File Name" Checked="NamingRadio_Checked"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Export Destination Section -->
                    <GroupBox Header="Export Destination" Margin="0,0,0,16" Padding="10">
                        <StackPanel>
                            <RadioButton x:Name="DesktopDestRadio" Content="New Desktop Folder" IsChecked="True"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Export Action Button -->
                    <Button x:Name="ExportButton" Content="🚀 Export Files" Click="Export_Click" Height="42" Background="{StaticResource AccentColor}" Foreground="White" FontSize="15" FontWeight="Bold" Cursor="Hand"/>

                    <ProgressBar x:Name="ExportProgressBar" Height="8" Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="ProgressStatusText" Text="" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>

                    <Button x:Name="OpenFolderButton" Content="📂 Open Destination Folder" Click="OpenFolder_Click" Margin="0,10,0,0" Visibility="Collapsed"/>

                    <TextBlock Text="Created by arulmjoseph.com" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
