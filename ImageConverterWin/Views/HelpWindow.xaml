<Window x:Class="ImageConverterWin.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Image Converter Help &amp; Guide" Height="550" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F9F9FC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Image Converter Guide &amp; Features" FontSize="20" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <!-- 1. Drag & Drop -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="1. Drag &amp; Drop Images &amp; PDFs" FontSize="14" FontWeight="Bold" Foreground="#1E1E1E"/>
                        <TextBlock Text="Drag single or bulk image files, PDF documents, or entire folders into the window." FontSize="12" Foreground="#666666" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 2. Target Format -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="2. Target Format Selection" FontSize="14" FontWeight="Bold" Foreground="#1E1E1E"/>
                        <TextBlock Text="Supported Output Formats:" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,2"/>
                        <TextBlock Text="• WEBP (Best for Website ⭐)" FontSize="12" Foreground="#666666"/>
                        <TextBlock Text="• PDF (Optimized Document &amp; PDF 📄)" FontSize="12" Foreground="#666666"/>
                        <TextBlock Text="• JPG, PNG, HEIC, AVIF, TIFF, BMP, GIF" FontSize="12" Foreground="#666666"/>
                        <TextBlock Text="💡 PDF Optimization: Drag PDF files and export as PDF to downsample embedded images, compress PDF file size, and strip document metadata." FontSize="11" Foreground="#007ACC" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 3. Width Resizing -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="3. Custom Width &amp; Proportional Scaling" FontSize="14" FontWeight="Bold" Foreground="#1E1E1E"/>
                        <TextBlock Text="Enter any custom pixel width (e.g. 500, 1200). Height automatically resizes proportionally preserving aspect ratio." FontSize="12" Foreground="#666666" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 4. Bulk SEO Renamer -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="4. File Renaming &amp; Bulk SEO Keywords" FontSize="14" FontWeight="Bold" Foreground="#1E1E1E"/>
                        <TextBlock Text="Paste raw keyword phrases into the editor. Automatically generates dash-separated SEO file names:" FontSize="12" Foreground="#666666" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="cfo-financial-strategy-meeting-middle-east.webp" FontFamily="Consolas" FontSize="11" Foreground="#2E7D32" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 5. Export -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="5. Automatic Desktop Export" FontSize="14" FontWeight="Bold" Foreground="#1E1E1E"/>
                        <TextBlock Text="Outputs automatically to a timestamped folder on Desktop with a one-click 'Open in Explorer' button." FontSize="12" Foreground="#666666" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Close" Width="100" Height="32" HorizontalAlignment="Right" Margin="0,15,0,0" Click="Close_Click"/>
    </Grid>
</Window>
