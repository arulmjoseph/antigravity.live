<Application x:Class="ImageConverterWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AccentColor" Color="#007ACC" />
            <SolidColorBrush x:Key="AccentHoverColor" Color="#005A9E" />
            <SolidColorBrush x:Key="WindowBackground" Color="#F4F4F9" />
            <SolidColorBrush x:Key="SidebarBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0" />
            <SolidColorBrush x:Key="TextPrimary" Color="#1E1E1E" />
            <SolidColorBrush x:Key="TextSecondary" Color="#666666" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
